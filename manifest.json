{
  "manifest_version": 3,
  "name": "LinkedIn Feed Scroller",
  "version": "1.9.0",
  "description": "LinkedIn feed popup with three adaptive human-like scroll modes and local multilingual hiring detection.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "Open LinkedIn Feed Scroller",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin-hiring-rules.js",
        "linkedin-hiring-classifier.js",
        "linkedin-hiring-monitor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
