{
  "manifest_version": 3,
  "name": "Linkerter – Adaptive LinkedIn Feed",
  "version": "2.0.0",
  "minimum_chrome_version": "110",
  "description": "Adaptive LinkedIn feed scrolling with local multilingual hiring detection, private history, and safe exports.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "infrastructure/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "Open Linkerter",
    "default_popup": "features/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open the Linkerter popup"
    },
    "toggle-monitor": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Start or stop the hiring monitor"
    },
    "toggle-scroll": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start or pause feed scrolling"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/",
        "https://www.linkedin.com/feed",
        "https://www.linkedin.com/feed/*"
      ],
      "js": [
        "core/sha256.js",
        "core/linkedin-shared.js",
        "core/linkedin-hiring-rules.js",
        "core/linkedin-hiring-classifier.js",
        "features/feed-monitor/linkedin-post-extract.js",
        "features/feed-monitor/linkedin-hiring-monitor.js",
        "features/feed-monitor/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
