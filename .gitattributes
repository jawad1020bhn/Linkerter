# Ensure shell and extensionless Superpowers scripts always keep LF line endings on Windows/macOS/Linux
*.sh text eol=lf
*.cmd text eol=lf
**/hooks/session-start text eol=lf
**/scripts/sdd-workspace text eol=lf
**/scripts/task-brief text eol=lf
**/scripts/review-package text eol=lf
**/scripts/task-start text eol=lf
**/scripts/task-done text eol=lf

# Common text assets
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
