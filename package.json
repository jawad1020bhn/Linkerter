{
  "name": "linkerter-extension-development",
  "version": "2.0.0",
  "private": true,
  "description": "Development-only tests and release tooling for the zero-dependency Linkerter Chrome extension.",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/dom/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:classifier": "node scripts/evaluate-classifier.js",
    "test:browser": "bash scripts/test-browser.sh",
    "probe:classifier": "node scripts/probe-classifier.js",
    "probe:feed": "node scripts/probe-feed-roots.js",
    "preview:popup": "node scripts/preview-popup.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "puppeteer-core": "24.23.0"
  }
}
